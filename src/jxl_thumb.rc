#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    JXLTHUMB_VERSION_MAJOR,JXLTHUMB_VERSION_MINOR,JXLTHUMB_VERSION_PATCH,0
 PRODUCTVERSION JXLTHUMB_VERSION_MAJOR,JXLTHUMB_VERSION_MINOR,JXLTHUMB_VERSION_PATCH,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "rsilvabr"
            VALUE "FileDescription",  "jxl-thumb - fast JPEG XL thumbnails for Windows Explorer"
            VALUE "FileVersion",      JXLTHUMB_VERSION_STR
            VALUE "InternalName",     "jxl_thumb"
            VALUE "LegalCopyright",   "MIT License. Includes libjxl, Brotli, Highway, skcms (BSD/Apache/MIT)."
            VALUE "OriginalFilename", "jxl_thumb.dll"
            VALUE "ProductName",      "jxl-thumb"
            VALUE "ProductVersion",   JXLTHUMB_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
